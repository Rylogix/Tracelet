{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tracelet-sherlock",
  "main": "worker.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "containers": [{
    "class_name": "SherlockContainer",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "./Dockerfile" } }
  }],
  "durable_objects": { "bindings": [{ "name": "SHERLOCK", "class_name": "SherlockContainer" }] },
  "exports": { "SherlockContainer": { "type": "durable-object", "storage": "sqlite" } },
  "observability": { "enabled": false }
}
